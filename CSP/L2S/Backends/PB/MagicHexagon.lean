import CSP.L2S.Backends.PB.Adapter
import CSP.L2S.Constraints

namespace CSP.L2S.PB.MagicHexagon

open CSP.L2S CSP.L2S.PB

/-!
# PB backend — end-to-end verified UNSAT for the order-2 magic hexagon

A *normal magic hexagon* of order `n` fills a hexagonal board with the consecutive
integers `1 .. 3n²−3n+1` so that every line, in all three axial directions, has the
same sum.  Such a hexagon exists only for `n ∈ {1, 3}` (Trigg 1964): for every other
order the forced common line sum
`M(n) = (3n²−3n+1)(3n²−3n+2) / (2(2n−1))` is not an integer.

The smallest impossible order is `n = 2`: a board of `7` cells filled with `1 .. 7`,

```
   a b
  c d e
   f g
```

with nine lines, three per direction, each direction partitioning all seven cells:

* rows                `{a,b}`, `{c,d,e}`, `{f,g}`;
* "`╲`" diagonals      `{a,c}`, `{b,d,f}`, `{e,g}`;
* "`╱`" diagonals      `{b,e}`, `{a,d,g}`, `{c,f}`.

Because the seven values are a permutation of `1 .. 7` their total is `28`, and each
direction splits that total over its three lines, so a common line sum `M` would have
`3M = 28` — impossible for an integer `M`.  This is a **divisibility contradiction
native to cutting planes**: no probing is needed, the instance is provably UNSAT.

## Encoding

`magicHexagon2` is modelled directly (it is not a pre-existing corpus problem): seven
integer cell variables `a 0 .. a 6` over `{1 .. 7}`, an `alldifferent` over all seven,
and the nine line constraints written as "this line equals the middle row `{c,d,e}`"
(`linear_eq`).  Forcing every line to equal one fixed line `{c,d,e}` makes them all
equal — a faithful encoding of the magic property.

It additionally carries the **redundant total-sum constraint** `a 0 + … + a 6 = 28`.
This is implied by `alldifferent` (seven distinct values from `{1..7}` sum to `28`), so
it does not change the solution set; it lets the cutting-planes certificate exhibit the
divisibility obstruction `3M = 28` directly, instead of first re-deriving the total from
the all-different counting argument (which blows the certificate up by ~3×).

The Lean proof refutes the purely **linear** core: the total `a 0 + … + a 6 = 28`
together with the two row equalities `a 0 + a 1 = a 2 + a 3 + a 4` (top = middle) and
`a 5 + a 6 = a 2 + a 3 + a 4` (bottom = middle) — the three rows partition the board, so
`3·(a 2 + a 3 + a 4) = 28`, a contradiction.  Every fact is a linear `≤`/`=` over the
cells, so the proof rides the clean `unsat_of_pb` spine (`Adapter.lean`).  Domain
`{1 .. 7}` has width `6`, so cell `i` maps to OPB thresholds `x{6i+1 .. 6i+6}` (42
variables) with a non-empty order-encoding `monotonicity` staircase.
-/

/-! ### The CSP -/

/-- The scope of the all-different and total-sum constraints: all seven cells. -/
def mhCellScope : _root_.Vector (VarType 7) 7 := ⟨#[0, 1, 2, 3, 4, 5, 6], rfl⟩

/-- Top row `{a,b} = {0,1}` equals the middle row `{c,d,e} = {2,3,4}`:
    `a 0 + a 1 − a 2 − a 3 − a 4 = 0`. -/
def mhTopEqMid : TaggedConstraint 7 :=
  linear_eq (⟨#[0, 1, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
    (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0

/-- Bottom row `{f,g} = {5,6}` equals the middle row `{c,d,e} = {2,3,4}`:
    `a 5 + a 6 − a 2 − a 3 − a 4 = 0`. -/
def mhBotEqMid : TaggedConstraint 7 :=
  linear_eq (⟨#[5, 6, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
    (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0

/-- The remaining six magic lines, each written as "line = middle row `{c,d,e}`":
    forcing every line to equal `{c,d,e}` completes the magic property.  Present for
    faithfulness; not used by the (rows-only) refutation. -/
def mhCrossLines : List (TaggedConstraint 7) :=
  [ -- "╲" diagonal {a,c} = {0,2}
    linear_eq (⟨#[0, 2, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
      (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0,
    -- "╲" diagonal {b,d,f} = {1,3,5}
    linear_eq (⟨#[1, 3, 5, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 6)
      (⟨#[1, 1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 6) 0,
    -- "╲" diagonal {e,g} = {4,6}
    linear_eq (⟨#[4, 6, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
      (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0,
    -- "╱" diagonal {b,e} = {1,4}
    linear_eq (⟨#[1, 4, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
      (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0,
    -- "╱" diagonal {a,d,g} = {0,3,6}
    linear_eq (⟨#[0, 3, 6, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 6)
      (⟨#[1, 1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 6) 0,
    -- "╱" diagonal {c,f} = {2,5}
    linear_eq (⟨#[2, 5, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
      (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0 ]

/-- The order-2 magic hexagon as a `IntCSP`: seven cells over `{1 .. 7}`,
    `alldifferent`, the (redundant) total-sum `= 28`, and the nine line-equalities. -/
def magicHexagon2 : IntCSP :=
  ⟨7, ((List.finRange 7).map (fun i => bound i 1 7))
      ++ (alldifferent mhCellScope :: sum_eq mhCellScope 28
          :: mhTopEqMid :: mhBotEqMid :: mhCrossLines)⟩

/-! ### The signature and the linear `≤` constraint list -/

/-- The PB signature: seven integer cell variables over the domain `{1 .. 7}`.
    Definitionally equal to `toCSPSig magicHexagon2 (fun _ => 1) (fun _ => 7) _`. -/
def mhSig : CSPSig where
  nInt := 7
  nBool := 0
  nAux := 0
  values := fun _ => domainValues 1 7
  sorted := fun _ => domainValues_sorted 1 7
  nonempty := fun _ => domainValues_nonempty (by norm_num)

/-- The linear `≤` core fed to `unsat_of_pb`: the total `= 28` and the two row
    equalities, each as its two `≤` halves. -/
def mhLin : List (List (Int × Fin 7) × Int) :=
  [ ([(1, (0 : Fin 7)), (1, 1), (1, 2), (1, 3), (1, 4), (1, 5), (1, 6)], 28),
    ([(-1, (0 : Fin 7)), (-1, 1), (-1, 2), (-1, 3), (-1, 4), (-1, 5), (-1, 6)], -28),
    ([(1, (0 : Fin 7)), (1, 1), (-1, 2), (-1, 3), (-1, 4)], 0),
    ([(-1, (0 : Fin 7)), (-1, 1), (1, 2), (1, 3), (1, 4)], 0),
    ([(1, (5 : Fin 7)), (1, 6), (-1, 2), (-1, 3), (-1, 4)], 0),
    ([(-1, (5 : Fin 7)), (-1, 6), (1, 2), (1, 3), (1, 4)], 0) ]

/-! ### Bridges from a solution to the linear facts -/

/-- Every variable has its `bound 1 7` constraint in the CSP. -/
theorem mh_hbound (i : Fin magicHexagon2.num_vars) :
    bound i 1 7 ∈ magicHexagon2.constraints := by
  show bound i 1 7 ∈ ((List.finRange 7).map (fun i => bound i 1 7)) ++ _
  apply List.mem_append_left
  exact List.mem_map.mpr ⟨i, List.mem_finRange i, rfl⟩

/-- Every linear `≤` fact in `mhLin` follows from any solution: the total-sum
    constraint gives `Σ = 28`, and the two row `linear_eq`s give the row equalities. -/
theorem mh_hlin (a : IntAssignment 7) (hsol : magicHexagon2.isSolutionInt a) :
    ∀ c ∈ mhLin, (c.1.map (fun p => p.1 * a p.2)).sum ≤ c.2 := by
  -- total sum = 28
  have hsum : a 0 + a 1 + a 2 + a 3 + a 4 + a 5 + a 6 = 28 := by
    have hs := sum_eq_sat mhCellScope 28 a (by
      apply hsol
      apply List.mem_append_right
      exact List.mem_cons_of_mem _ List.mem_cons_self)
    simp [mhCellScope] at hs
    linarith [hs]
  -- top row = middle row
  have hTop : a 0 + a 1 - a 2 - a 3 - a 4 = 0 := by
    have hs := linear_eq_sat (⟨#[0, 1, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
      (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0 a (by
      apply hsol
      apply List.mem_append_right
      exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))
    simp at hs
    linarith [hs]
  -- bottom row = middle row
  have hBot : a 5 + a 6 - a 2 - a 3 - a 4 = 0 := by
    have hs := linear_eq_sat (⟨#[5, 6, 2, 3, 4], rfl⟩ : _root_.Vector (VarType 7) 5)
      (⟨#[1, 1, -1, -1, -1], rfl⟩ : _root_.Vector ℤ 5) 0 a (by
      apply hsol
      apply List.mem_append_right
      exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ List.mem_cons_self)))
    simp at hs
    linarith [hs]
  intro c hc
  simp only [mhLin, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl <;>
    · simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
      linarith [hsum, hTop, hBot]

