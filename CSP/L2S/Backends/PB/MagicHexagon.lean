/-- The PB encoding of the order-2 magic hexagon's linear core is unsatisfiable —
    established by the external PB certificate, kernel-checked through PBLean's verified
    reflection checker (`native_decide` runs the checker; RoundingSat / veripb / the
    serializer are untrusted). -/
theorem mh_formulaUnsat :
    VeriPB.Reflect.formulaUnsat
      ((encodeLinear mhSig mhLin).toArray.map PBConstr.toNatConstr) :=
  VeriPB.Reflect.checkProof_sound _ 42 mhKernelProof (by native_decide)

/-- **End-to-end magic-hexagon UNSAT.** The order-2 normal magic hexagon
    `magicHexagon2` is unsatisfiable: `1 .. 7` cannot fill the seven cells with all
    lines equal.  Discharged through the verified PB pipeline — the `sum_eq` and
    `linear_eq` bridges turn any solution into the total `= 28` and the two row
    equalities, the `unsat_of_pb` spine order-encodes them via `encodeLinear`, and the
    committed certificate `mh_formulaUnsat` derives the divisibility contradiction
    `3·(a 2 + a 3 + a 4) = 28`. -/
theorem magic_hexagon_2_unsat : ¬ magicHexagon2.isSatisfiableInt := by
  refine unsat_of_pb magicHexagon2 (fun _ => 1) (fun _ => 7) (fun _ => by norm_num)
    mh_hbound mhLin mh_hlin ?_
  show VeriPB.Reflect.formulaUnsat
    ((encodeLinear mhSig mhLin).toArray.map PBConstr.toNatConstr)
  exact mh_formulaUnsat

end CSP.L2S.PB.MagicHexagon
