/-- The PB encoding of the peaceable-armies query is unsatisfiable — established by the
    external PB certificate, kernel-checked through PBLean's verified reflection checker
    (`native_decide` runs the checker; RoundingSat / veripb / the serializer are
    untrusted). -/
theorem pa_formulaUnsat :
    VeriPB.Reflect.formulaUnsat
      ((encodeLinear paSig paLin).toArray.map PBConstr.toNatConstr) :=
  VeriPB.Reflect.checkProof_sound _ 32 paKernelProof (by native_decide)

/-- **End-to-end peaceable-armies UNSAT.** Three white and three black queens cannot
    coexist peaceably on the `4 × 4` board: `a(4) = 2`, so `k = 3` is infeasible.
    Discharged through the verified PB pipeline — the cardinality and `at_most_k` bridges
    turn any solution into the army-size and exclusion inequalities, the `unsat_of_pb`
    spine order-encodes them via `encodeLinear`, and the committed certificate
    `pa_formulaUnsat` contradicts it. -/
theorem peaceable_armies_4_3_unsat : ¬ peaceableArmies.isSatisfiableInt := by
  refine unsat_of_pb peaceableArmies (fun _ => 0) (fun _ => 1) (fun _ => by norm_num)
    pa_hbound paLin pa_hlin ?_
  show VeriPB.Reflect.formulaUnsat
    ((encodeLinear paSig paLin).toArray.map PBConstr.toNatConstr)
  exact pa_formulaUnsat

end CSP.L2S.PB.PeaceableArmies
