/-- The veripb-elaborated kernel proof of UNSAT for `mcLin`'s OPB serialization
    (RoundingSat + veripb; both untrusted).  The single `pol` step is the
    colour-counting linear combination. -/
def mcKernelProof : String :=
"pseudo-Boolean proof version 3.0
f 68;
rup >= 0 : ~ ;
pol 69 2 1000000000000000 * + 3 1000000000000000 * + 6 1000000000000000 * + 7 1000000000000000 * + 10 1000000000000000 * + 12 1000000000000000 * + 13 1000000000000000 * + 16 1000000000000000 * + 17 1000000000000000 * + 20 1000000000000000 * + 21 1000000000000000 * + 23 1000000000000000 * + 26 1000000000000000 * + 27 1000000000000000 * + 30 1000000000000000 * + 31 1000000000000000 * + 34 1000000000000000 * + 36 1000000000000000 * + 37 1000000000000000 * + 40 1000000000000000 * + 41 1000000000000000 * + 44 1000000000000000 * + 45 1000000000000000 * + 47 1000000000000000 * + 50 1000000000000000 * + 51 1000000000000000 * + 54 1000000000000000 * + 55 1000000000000000 * + 58 1000000000000000 * + 60 1000000000000000 * + 61 1000000000000000 * + 64 1000000000000000 * + 65 1000000000000000 * + 68 1000000000000000 * +;
output NONE ;
conclusion UNSAT : 70;
end pseudo-Boolean proof;
"

/-- The PB encoding of the 6 × 6 mutilated chessboard's exact-cover
    query is unsatisfiable — kernel-checked through PBLean's verified reflection
    checker (`native_decide`; RoundingSat / veripb / serializer untrusted). -/
theorem mc_formulaUnsat :
    VeriPB.Reflect.formulaUnsat
      ((encodeLinear mcSig mcLin).toArray.map PBConstr.toNatConstr) :=
  VeriPB.Reflect.checkProof_sound _ 56 mcKernelProof (by native_decide)

/-- **End-to-end mutilated-chessboard UNSAT (6 × 6).** A 6 × 6
    board minus two opposite (same-colour) corners cannot be tiled by dominoes,
    via the verified PB pipeline and the committed colour-counting certificate. -/
theorem mutilated_chessboard_6_unsat : ¬ mutilatedChessboard6.isSatisfiableInt := by
  refine unsat_of_pb mutilatedChessboard6 (fun _ => 0) (fun _ => 1)
    (fun _ => by norm_num) mc_hbound mcLin mc_hlin ?_
  show VeriPB.Reflect.formulaUnsat
    ((encodeLinear mcSig mcLin).toArray.map PBConstr.toNatConstr)
  exact mc_formulaUnsat

end CSP.L2S.PB.MutilatedChessboard6
