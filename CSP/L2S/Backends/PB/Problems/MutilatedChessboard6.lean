/-- Every placement variable has its `bound 0 1` constraint in the CSP. -/
theorem mc_hbound (i : Fin mutilatedChessboard6.num_vars) :
    bound i 0 1 ∈ mutilatedChessboard6.constraints := by
  show bound i 0 1 ∈ ((List.finRange 56).map (fun i => bound i 0 1)) ++ _
  apply List.mem_append_left
  exact List.mem_map.mpr ⟨i, List.mem_finRange i, rfl⟩

set_option maxHeartbeats 1600000 in
/-- Every linear `≤` fact in `mcLin` follows from any solution (each cell's
    `sum_eq … = 1` gives `Σ covering placements = 1`, whose two `≤` halves are the
    `mcLin` entries).  The heartbeat bump accommodates the 34-cell ×
    2-half mechanical case split (larger than the 4 × 4 instance's). -/
theorem mc_hlin (a : IntAssignment 56)
    (hsol : mutilatedChessboard6.isSolutionInt a) :
    ∀ c ∈ mcLin, (c.1.map (fun p => p.1 * a p.2)).sum ≤ c.2 := by
  unfold IntCSP.isSolutionInt mutilatedChessboard6 at hsol
  simp only [List.forall_mem_append, List.forall_mem_cons] at hsol
  obtain ⟨_hbounds, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, h29, h30, h31, h32, h33, _⟩ := hsol
  have hs0 := sum_eq_sat ⟨#[0, 1], rfl⟩ 1 a h0
  simp at hs0
  have hs1 := sum_eq_sat ⟨#[0, 2, 3], rfl⟩ 1 a h1
  simp at hs1
